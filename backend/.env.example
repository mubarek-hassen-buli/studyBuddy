# ==============================================================================
# STUDYBUDDY BACKEND ENVIRONMENT VARIABLES (.env.example)
# ==============================================================================

# Server Configuration
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Primary Database (Neon Serverless PostgreSQL)
DATABASE_URL=postgresql://user:password@ep-xyz.neon.tech/neondb?sslmode=require

# Authentication (Better-Auth)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=your_32_character_secret_here
BETTER_AUTH_URL=http://localhost:3001

# Google Gemini AI (LLM & Embeddings)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Vector Database (Qdrant Cloud)
QDRANT_URL=https://your-cluster-id.region.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here

# File Storage (ImageKit)
IMAGEKIT_PUBLIC_KEY=public_your_public_key_here
IMAGEKIT_PRIVATE_KEY=private_your_private_key_here
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
